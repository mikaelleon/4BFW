# Discord Developer Portal -> your application
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register slash commands to ONE server instantly (for testing).
# Leave empty to register globally (needed for DM use; can take up to ~1h to appear).
DEV_GUILD_ID=

# Word users type before a DM submission. Default: fw
BOT_PREFIX=fw

# IANA timezone for dates in embeds. Default: Asia/Manila
TIMEZONE=Asia/Manila

# Pins the key used to hash user IDs in warnings, bans, notes, votes and reports.
# Set a long random string once and never change it. If you leave this empty, the
# key is derived from DISCORD_TOKEN, and resetting the token breaks existing bans.
ID_HASH_SECRET=

# Optional encrypted database backups, posted to a private channel the bot can see.
# Both must be set or backups stay off. Never change the passphrase: old backups
# cannot be decrypted without it.
BACKUP_CHANNEL_ID=
BACKUP_PASSPHRASE=

# HTTP keep-alive port (Render and similar hosts). Default: 3000
PORT=3000

# Public address of this server, e.g. https://your-app.onrender.com. The guide links to <PUBLIC_URL>/legal
# (Terms of Use and Privacy Policy). Render sets RENDER_EXTERNAL_URL itself, so it can stay empty there.
PUBLIC_URL=
